# ============================================================
# 配置模板文件（可以安全提交到 GitHub，里面没有任何真实密钥）
#
# 用法：
#   1. 复制本文件为 .env ：  Copy-Item .env.example .env
#   2. 用编辑器打开 .env，把下面的值换成你自己的
#   3. .env 已被 .gitignore 排除，永不提交 —— 也不要手动 git add 它
#
# 换厂商时，只改下面这三行，代码一行都不用动
# ============================================================

# 你的 API Key
LLM_API_KEY=sk-在这里填你的Key

# 接口地址
#   智谱 GLM ：https://open.bigmodel.cn/api/paas/v4/chat/completions
#   DeepSeek ：https://api.deepseek.com/chat/completions
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 模型名（会不断更新，以官网文档 / 控制台为准）
#   智谱 GLM ：glm-4-flash（输出干净，适合入门）
#              glm-4.7-flash / glm-4.6（推理模型，回答前会先"思考"）
#   DeepSeek ：deepseek-chat
LLM_MODEL=glm-4-flash
